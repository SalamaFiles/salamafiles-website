---
import ShieldCheck from "./icons/ShieldCheck.astro";
import FolderLock from "./icons/FolderLock.astro";
import UsersRound from "./icons/UsersRound.astro";
import Workflow from "./icons/Workflow.astro";
import FileText from "./icons/FileText.astro";
import ChartColumn from "./icons/ChartColumn.astro";
---

<section id="features" class="features-section">

  <div class="container">

    <div class="section-heading">

      <span class="eyebrow">
        Platform Features
      </span>

      <h2>
        Everything your safeguarding team needs
      </h2>

      <p>
        SalamaFiles centralizes safeguarding case management in one secure platform,
        helping organizations respond faster, collaborate safely, and protect vulnerable
        communities with confidence.
      </p>

    </div>

    <div class="features-grid">

      <article class="card">

        <div class="icon">
          <ShieldCheck />
        </div>

        <h3>Secure Case Reporting</h3>

        <p>
          Receive safeguarding reports through a secure platform designed to protect
          sensitive information and reporter confidentiality.
        </p>

      </article>

      <article class="card">

        <div class="icon">
          <FolderLock />
        </div>

        <h3>Case Management</h3>

        <p>
          Manage every safeguarding case from intake to closure with a complete
          investigation timeline and centralized documentation.
        </p>

      </article>

      <article class="card">

        <div class="icon">
          <UsersRound />
        </div>

        <h3>Role-Based Access</h3>

        <p>
          Ensure only authorized personnel can access sensitive cases using configurable
          roles and permissions.
        </p>

      </article>

      <article class="card">

        <div class="icon">
          <Workflow />
        </div>

        <h3>Investigation Workflow</h3>

        <p>
          Assign investigators, monitor progress, document actions, and resolve cases
          using structured safeguarding workflows.
        </p>

      </article>

      <article class="card">

        <div class="icon">
          <FileText />
        </div>

        <h3>Evidence & Documentation</h3>

        <p>
          Securely store notes, attachments, interviews, and investigation evidence in
          one organized case file.
        </p>

      </article>

      <article class="card">

        <div class="icon">
          <ChartColumn />
        </div>

        <h3>Reports & Insights</h3>

        <p>
          Understand safeguarding trends through dashboards, analytics, and management
          reports that support informed decision-making.
        </p>

      </article>

    </div>

  </div>

</section>

<style>

.features-section{
    padding:8rem 0;
    background:#F8FAFC;
}

.section-heading{
    text-align:center;
    max-width:760px;
    margin:0 auto 4rem;
}

.section-heading .eyebrow{
    display:inline-flex;
    align-items:center;
    padding:.65rem 1rem;
    background:#E8F8F5;
    color:var(--primary);
    border-radius:999px;
    font-weight:600;
    font-size:.9rem;
    margin-bottom:1.5rem;
}

.section-heading h2{
    font-size:2.8rem;
    font-weight:800;
    line-height:1.2;
    letter-spacing:-1px;
    margin-bottom:1.25rem;
    color:var(--text);
}

.section-heading p{
    color:var(--muted);
    font-size:1.08rem;
    line-height:1.8;
}

.features-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:2rem;
}

.card{
    background:#fff;
    border:1px solid #E5E7EB;
    border-radius:22px;
    padding:2rem;
    transition:all .25s ease;
}

.card:hover{
    transform:translateY(-6px);
    border-color:#D8EDE8;
    box-shadow:
        0 18px 40px rgba(15,118,110,.08);
}

.icon{
    width:64px;
    height:64px;
    border-radius:18px;
    background:#ECFDF5;
    display:flex;
    justify-content:center;
    align-items:center;
    margin-bottom:1.5rem;
}

.icon svg{
    width:28px;
    height:28px;
    color:var(--primary);
}

.card h3{
    font-size:1.25rem;
    font-weight:700;
    margin-bottom:1rem;
    color:var(--text);
}

.card p{
    color:var(--muted);
    line-height:1.75;
}

@media (max-width:1024px){

.features-grid{
    grid-template-columns:repeat(2,1fr);
}

}

@media (max-width:768px){

.features-section{
    padding:6rem 0;
}

.features-grid{
    grid-template-columns:1fr;
}

.section-heading h2{
    font-size:2.2rem;
}

.card{
    padding:1.75rem;
}

}

</style>