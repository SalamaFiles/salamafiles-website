---
import ShieldCheck from "./icons/ShieldCheck.astro";
import Workflow from "./icons/Workflow.astro";
import FileText from "./icons/FileText.astro";
import ChartColumn from "./icons/ChartColumn.astro";
---

<section id="how-it-works" class="how-section">

  <div class="container">

    <div class="section-heading">

      <span class="eyebrow">
        How It Works
      </span>

      <h2>
        From report to resolution in four simple steps
      </h2>

      <p>
        SalamaFiles streamlines safeguarding case management by guiding your team
        through every stage of the response process while keeping sensitive
        information secure.
      </p>

    </div>

    <div class="steps">

      <div class="step">

        <div class="step-number">01</div>

        <div class="step-icon">
          <ShieldCheck />
        </div>

        <h3>Receive Reports</h3>

        <p>
          Staff, beneficiaries, or community members securely submit safeguarding
          concerns through protected reporting channels.
        </p>

      </div>

      <div class="connector"></div>

      <div class="step">

        <div class="step-number">02</div>

        <div class="step-icon">
          <Workflow />
        </div>

        <h3>Assign & Investigate</h3>

        <p>
          Cases are assigned to authorized safeguarding officers who investigate,
          collaborate, and track every action taken.
        </p>

      </div>

      <div class="connector"></div>

      <div class="step">

        <div class="step-number">03</div>

        <div class="step-icon">
          <FileText />
        </div>

        <h3>Document Evidence</h3>

        <p>
          Store interviews, notes, files, and supporting evidence in one secure
          digital case file with a complete audit trail.
        </p>

      </div>

      <div class="connector"></div>

      <div class="step">

        <div class="step-number">04</div>

        <div class="step-icon">
          <ChartColumn />
        </div>

        <h3>Resolve & Learn</h3>

        <p>
          Close cases, generate reports, monitor trends, and strengthen your
          safeguarding practices using actionable insights.
        </p>

      </div>

    </div>

  </div>

</section>

<style>

.how-section{
    padding:7rem 0;
    background:white;
}

.section-heading{
    text-align:center;
    max-width:760px;
    margin:0 auto 4rem;
}

.eyebrow{
    display:inline-flex;
    padding:.6rem 1rem;
    border-radius:999px;
    background:#E8F8F5;
    color:var(--primary);
    font-weight:600;
    margin-bottom:1.5rem;
    font-size:.9rem;
}

.section-heading h2{
    font-size:2.8rem;
    margin-bottom:1rem;
    color:var(--text);
}

.section-heading p{
    color:var(--muted);
    font-size:1.1rem;
    line-height:1.8;
}

.steps{
    display:grid;
    grid-template-columns:1fr auto 1fr auto 1fr auto 1fr;
    align-items:start;
    gap:1.5rem;
}

.step{
    background:#fff;
    border:1px solid #E5E7EB;
    border-radius:22px;
    padding:2rem;
    text-align:center;
    transition:.3s;
    position:relative;
}

.step:hover{
    transform:translateY(-6px);
    box-shadow:0 20px 40px rgba(15,23,42,.08);
}

.step-number{
    position:absolute;
    top:18px;
    right:18px;
    font-size:.8rem;
    font-weight:700;
    color:#94A3B8;
}

.step-icon{
    width:72px;
    height:72px;
    margin:0 auto 1.5rem;
    display:flex;
    align-items:center;
    justify-content:center;
    background:#ECFDF5;
    border-radius:18px;
}

.step-icon svg{
    width:34px;
    height:34px;
    color:var(--primary);
}

.step h3{
    margin-bottom:1rem;
    font-size:1.25rem;
    color:var(--text);
}

.step p{
    color:var(--muted);
    line-height:1.7;
    font-size:.95rem;
}

.connector{
    width:60px;
    height:2px;
    background:#D1D5DB;
    margin-top:90px;
}

@media(max-width:1100px){

.steps{
    grid-template-columns:1fr;
}

.connector{
    display:none;
}

.step{
    text-align:left;
}

.step-icon{
    margin:0 0 1.5rem;
}

}

</style>