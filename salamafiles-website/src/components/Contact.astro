---
import Mail from "./icons/Mail.astro";
import Phone from "./icons/Phone.astro";
import MapPin from "./icons/MapPin.astro";
---

<section id="contact" class="contact-section">

  <div class="container">

    <div class="section-heading">

      <span class="eyebrow">
        Contact Us
      </span>

      <h2>
        We'd love to hear from you
      </h2>

      <p>
        Whether you're exploring SalamaFiles for your organization,
        looking to strengthen safeguarding processes, or simply have a
        question, our team is here to help.
      </p>

    </div>

    <div class="contact-grid">

      <div class="contact-info">

        <div class="contact-details">

          <div class="item">

            <div class="icon">
              <Mail />
            </div>

            <div>
              <strong>Email</strong>
              <span>hello@salamafiles.com</span>
            </div>

          </div>

          <div class="item">

            <div class="icon">
              <Phone />
            </div>

            <div>
              <strong>Phone</strong>
              <span>+254 700 000 000</span>
            </div>

          </div>

          <div class="item">

            <div class="icon">
              <MapPin />
            </div>

            <div>
              <strong>Location</strong>
              <span>Nairobi, Kenya</span>
            </div>

          </div>

        </div>

      </div>

      <form id="contactForm" class="contact-form">

        <h3>Send us a message</h3>

        <label>

          <span>Full Name</span>

          <input
            type="text"
            name="name"
            placeholder="John Doe"
            required
          />

        </label>

        <label>

          <span>Email Address</span>

          <input
            type="email"
            name="email"
            placeholder="john@example.org"
            required
          />

        </label>

        <label>

          <span>Organization</span>

          <input
            type="text"
            name="organization"
            placeholder="Organization Name"
          />

        </label>

        <label>

          <span>Subject</span>

          <input
            type="text"
            name="subject"
            placeholder="How can we help?"
            required
          />

        </label>

        <label>

          <span>Message</span>

          <textarea
            name="message"
            rows="5"
            placeholder="Tell us how we can help..."
            required
          ></textarea>

        </label>

        <button
          id="contactSubmit"
          type="submit"
          class="btn btn-primary">

          Send Message

        </button>

        <p id="contactResponse"></p>

      </form>

    </div>

  </div>

</section>

<script define:vars={{ apiUrl: import.meta.env.PUBLIC_API_URL }}>

const form = document.getElementById("contactForm");
const button = document.getElementById("contactSubmit");
const response = document.getElementById("contactResponse");

form?.addEventListener("submit", async (e) => {

    e.preventDefault();

    button.disabled = true;
    button.textContent = "Sending...";
    response.textContent = "";

    const body = Object.fromEntries(new FormData(form));

    try {

        const res = await fetch(`${apiUrl}/api/contact`, {

            method: "POST",

            headers: {
                "Content-Type": "application/json"
            },

            body: JSON.stringify(body)

        });

        const json = await res.json();

        if (!res.ok) {
            throw new Error(json.message || "Unable to send your message.");
        }

        response.style.color = "#16A34A";
        response.textContent = json.message;

        form.reset();

    } catch (err) {

        response.style.color = "#DC2626";
        response.textContent =
            err.message || "Something went wrong. Please try again.";

    } finally {

        button.disabled = false;
        button.textContent = "Send Message";

    }

});

</script>

<style>

.contact-section{
    padding:7rem 0;
    background:#F8FAFC;
}

.section-heading{
    max-width:760px;
    margin:0 auto 4rem;
    text-align:center;
}

.eyebrow{
    display:inline-flex;
    padding:.6rem 1rem;
    border-radius:999px;
    background:#E8F8F5;
    color:var(--primary);
    font-weight:600;
    font-size:.9rem;
    margin-bottom:1.5rem;
}

.section-heading h2{
    font-size:2.8rem;
    color:var(--text);
    margin-bottom:1rem;
}

.section-heading p{
    font-size:1.1rem;
    line-height:1.8;
    color:var(--muted);
}

.contact-grid{
    display:grid;
    grid-template-columns:1fr 1.1fr;
    gap:5rem;
    align-items:start;
}

.contact-details{
    display:flex;
    flex-direction:column;
    gap:1.5rem;
}

.item{
    display:flex;
    gap:18px;
    align-items:flex-start;
    padding:1.25rem;
    background:white;
    border:1px solid #E5E7EB;
    border-radius:18px;
    transition:.25s;
}

.item:hover{
    transform:translateY(-3px);
    box-shadow:0 10px 25px rgba(15,23,42,.06);
}

.icon{
    width:56px;
    height:56px;
    border-radius:14px;
    background:#ECFDF5;
    display:flex;
    align-items:center;
    justify-content:center;
    color:var(--primary);
    flex-shrink:0;
}

.icon svg{
    width:24px;
    height:24px;
}

.item strong{
    display:block;
    font-size:1rem;
    margin-bottom:4px;
    color:var(--text);
}

.item span{
    color:var(--muted);
}

.contact-form{
    background:white;
    padding:2rem;
    border-radius:20px;
    border:1px solid #E5E7EB;
    box-shadow:0 20px 40px rgba(15,23,42,.06);
    display:flex;
    flex-direction:column;
    gap:1.25rem;
}

.contact-form h3{
    margin-bottom:.5rem;
}

.contact-form label{
    display:flex;
    flex-direction:column;
    gap:.5rem;
    font-weight:600;
    color:var(--text);
}

.contact-form input,
.contact-form textarea{
    width:100%;
    padding:14px 16px;
    border:1px solid #D9E3EA;
    border-radius:12px;
    font-size:1rem;
    font-family:inherit;
    transition:.2s;
}

.contact-form input:focus,
.contact-form textarea:focus{
    outline:none;
    border-color:var(--primary);
    box-shadow:0 0 0 3px rgba(15,118,110,.12);
}

.contact-form textarea{
    resize:vertical;
}

.contact-form button{
    margin-top:.5rem;
    width:fit-content;
}

#contactResponse{
    margin-top:.5rem;
    font-weight:600;
}

@media(max-width:980px){

.contact-grid{
    grid-template-columns:1fr;
}

.contact-form button{
    width:100%;
}

}

</style>