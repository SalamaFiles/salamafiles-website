---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Request a Demo | SalamaFiles">

  <Navbar />

  <section class="demo-section">

    <div class="container demo-grid">

      <div class="demo-content">

        <span class="eyebrow">
          Request a Demo
        </span>

        <h1>
          See SalamaFiles in action
        </h1>

        <p>
          Schedule a personalized walkthrough and discover how SalamaFiles helps
          organizations securely manage safeguarding cases from reporting through
          resolution.
        </p>

        <div class="timeline">

          <div class="step">
            <div class="step-number">1</div>
            <div>
              <strong>Submit your request</strong>
              <p>Tell us about your organization.</p>
            </div>
          </div>

          <div class="step">
            <div class="step-number">2</div>
            <div>
              <strong>We'll contact you</strong>
              <p>Our team will reach out within one business day.</p>
            </div>
          </div>

          <div class="step">
            <div class="step-number">3</div>
            <div>
              <strong>Personalized Demo</strong>
              <p>We'll demonstrate how SalamaFiles fits your safeguarding workflows.</p>
            </div>
          </div>

        </div>

      </div>

      <form id="demoForm" class="demo-form">

        <h3>Request your demo</h3>

        <input
          name="name"
          placeholder="Full Name"
          required
        />

        <input
          type="email"
          name="email"
          placeholder="Work Email"
          required
        />

        <input
          name="organization"
          placeholder="Organization"
          required
        />

        <input
          name="country"
          placeholder="Country"
          required
        />

        <input
          name="users"
          placeholder="Approximate Number of Users"
        />

        <textarea
          name="message"
          rows="5"
          placeholder="Tell us about your safeguarding needs..."
        ></textarea>

        <!-- Cloudflare Turnstile goes here -->

        <button
          id="submitBtn"
          type="submit"
          class="btn btn-primary">

          Request Demo

        </button>

        <p class="privacy-note">
          We respect your privacy. Your information is used solely to schedule
          your demonstration and will never be shared with third parties.
        </p>

        <p id="response"></p>

      </form>

    </div>

  </section>

  <Footer />

</Layout>

<script>

document.addEventListener("DOMContentLoaded", () => {

    const API_URL = import.meta.env.PUBLIC_API_URL;

    const form = document.getElementById("demoForm");
    const button = document.getElementById("submitBtn");
    const response = document.getElementById("response");

    if (!form) return;

    form.addEventListener("submit", async (e) => {

        e.preventDefault();

        button.disabled = true;
        button.textContent = "Submitting...";

        response.textContent = "";
        response.className = "";

        const payload = Object.fromEntries(new FormData(form));

        try {

            const res = await fetch(`${API_URL}/api/demo-request`, {

                method: "POST",

                headers: {
                    "Content-Type": "application/json"
                },

                body: JSON.stringify({
                    ...payload,
                    turnstileToken: ""
                })

            });

            const json = await res.json();

            if (!res.ok) {
                throw new Error(json.message || "Unable to submit request.");
            }

            response.textContent =
                "✓ Thank you! We've received your request. Our team will contact you within one business day.";

            response.classList.add("success");

            form.reset();

        } catch (err) {

            response.textContent =
                err.message || "Something went wrong. Please try again.";

            response.classList.add("error");

        } finally {

            button.disabled = false;
            button.textContent = "Request Demo";

        }

    });

});

</script>

<style>

.demo-section{
    padding:6rem 0;
    background:#F8FAFC;
}

.demo-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:5rem;
    align-items:start;
}

.eyebrow{
    display:inline-flex;
    padding:.6rem 1rem;
    border-radius:999px;
    background:#E8F8F5;
    color:var(--primary);
    font-weight:600;
    margin-bottom:1.5rem;
}

.demo-content h1{
    font-size:3rem;
    line-height:1.1;
    margin-bottom:1.25rem;
}

.demo-content p{
    color:var(--muted);
    line-height:1.8;
}

.timeline{
    margin-top:3rem;
    display:flex;
    flex-direction:column;
    gap:1.5rem;
}

.step{
    display:flex;
    gap:1rem;
    align-items:flex-start;
}

.step-number{
    width:42px;
    height:42px;
    border-radius:50%;
    background:var(--primary);
    color:white;
    display:flex;
    align-items:center;
    justify-content:center;
    font-weight:700;
    flex-shrink:0;
}

.step strong{
    display:block;
    margin-bottom:.35rem;
}

.demo-form{
    background:white;
    border-radius:20px;
    padding:2rem;
    border:1px solid #E5E7EB;
    box-shadow:0 20px 40px rgba(15,23,42,.08);
    display:flex;
    flex-direction:column;
    gap:1rem;
}

.demo-form h3{
    margin-bottom:.5rem;
}

.demo-form input,
.demo-form textarea{
    width:100%;
    padding:15px 16px;
    border:1px solid #D9E3EA;
    border-radius:12px;
    font-size:1rem;
    font-family:inherit;
}

.demo-form input:focus,
.demo-form textarea:focus{
    outline:none;
    border-color:var(--primary);
}

.demo-form textarea{
    resize:vertical;
}

button:disabled{
    opacity:.7;
    cursor:not-allowed;
}

.privacy-note{
    font-size:.85rem;
    color:var(--muted);
    line-height:1.6;
    margin-top:.25rem;
}

#response{
    margin-top:1rem;
    font-weight:600;
}

#response.success{
    color:#16A34A;
}

#response.error{
    color:#DC2626;
}

@media(max-width:900px){

.demo-grid{
    grid-template-columns:1fr;
}

.demo-content{
    text-align:center;
}

.timeline{
    text-align:left;
}

}

</style>