---
import DashboardCard from "./DashboardCard.astro";

import {
  ShieldCheck,
  Building2,
  Workflow
} from "lucide-astro";
---

<section class="hero-section">

  <div class="container hero">

    <div class="hero-content">

      <span class="eyebrow">
        Built for NGOs • Humanitarian Organizations • Schools
      </span>

      <h1>
        Every safeguarding report.<br />
        One secure platform.
      </h1>

      <p>
        SalamaFiles enables organizations to receive safeguarding reports,
        investigate incidents, collaborate securely, and resolve cases with
        confidence — all from one centralized platform.
      </p>

      <div class="hero-actions">

        <a href="/request-demo" class="btn btn-primary">
          Request Demo
        </a>

        <a
          href="https://app.salamafiles.org"
          class="btn btn-secondary">

          Launch Platform

        </a>

      </div>

      <div class="hero-features">

        <div class="feature">

          <ShieldCheck size={22} strokeWidth={2} />

          <div>

            <strong>End-to-End Encryption</strong>

            <span>
              Every safeguarding report is securely protected.
            </span>

          </div>

        </div>

        <div class="feature">

          <Building2 size={22} strokeWidth={2} />

          <div>

            <strong>Multi-Organization Workspaces</strong>

            <span>
              Separate organizations with secure role-based access.
            </span>

          </div>

        </div>

        <div class="feature">

          <Workflow size={22} strokeWidth={2} />

          <div>

            <strong>Structured Case Workflows</strong>

            <span>
              Assign, investigate, escalate and resolve cases efficiently.
            </span>

          </div>

        </div>

      </div>

    </div>

    <div class="hero-dashboard">

      <DashboardCard />

    </div>

  </div>

</section>

<style>

.hero-section{
    padding:2rem 0 6rem;
    background:
        radial-gradient(circle at top right,#E8F8F5 0%,transparent 42%),
        linear-gradient(180deg,#FCFEFE 0%,#FFFFFF 100%);
}

.hero{
    display:grid;
    grid-template-columns:1.05fr .95fr;
    gap:1rem;
    align-items:center;
}

.hero-content{
    max-width:640px;
}

.eyebrow{

    display:inline-flex;
    align-items:center;

    padding:.65rem 1rem;

    border-radius:999px;

    background:#ECFDF5;

    color:var(--primary);

    border:1px solid #D1FAE5;

    font-weight:600;

    font-size:.9rem;

    margin-bottom:2rem;
}

.hero h1{

    font-size:4rem;

    line-height:1.05;

    letter-spacing:-2px;

    font-weight:800;

    color:var(--text);

    margin-bottom:1.5rem;
}

.hero p{

    font-size:1.15rem;

    line-height:1.85;

    color:var(--muted);

    margin-bottom:2.5rem;

    max-width:560px;
}

.hero-actions{

    display:flex;

    gap:18px;

    margin-bottom:3rem;
}

.btn{

    display:inline-flex;

    align-items:center;

    justify-content:center;

    padding:16px 32px;

    border-radius:14px;

    text-decoration:none;

    font-weight:600;

    transition:.25s ease;
}

.btn-primary{

    background:var(--primary);

    color:#fff;

    box-shadow:0 10px 30px rgba(15,118,110,.18);
}

.btn-primary:hover{

    transform:translateY(-2px);
}

.btn-secondary{

    background:#fff;

    border:1px solid #D9E3EA;

    color:var(--text);
}

.btn-secondary:hover{

    background:#F8FAFC;
}

.hero-features{

    display:flex;

    flex-direction:column;

    gap:1.5rem;
}

.feature{

    display:flex;

    gap:16px;

    align-items:flex-start;
}

.feature svg{

    color:var(--primary);

    flex-shrink:0;

    margin-top:4px;
}

.feature strong{

    display:block;

    margin-bottom:4px;

    font-size:1rem;

    color:var(--text);
}

.feature span{

    color:var(--muted);

    font-size:.95rem;

    line-height:1.6;
}

.hero-dashboard{

    display:flex;

    justify-content:center;

    position:relative;
}

.hero-dashboard::before{

    content:"";

    position:absolute;

    width:420px;

    height:420px;

    border-radius:50%;

    background:#D8F4EF;

    filter:blur(90px);

    z-index:-1;
}

@media (max-width:1024px){

.hero{

    grid-template-columns:1fr;

    text-align:center;

    gap:1rem;
}

.hero-content{

    margin:auto;
}

.hero h1{

    font-size:3rem;
}

.hero-actions{

    justify-content:center;
}

.hero-features{

    max-width:520px;

    margin:auto;
}

.feature{

    text-align:left;
}

}

@media (max-width:640px){

.hero h1{

    font-size:2.4rem;
}

.hero p{

    font-size:1.05rem;
}

.hero-actions{

    flex-direction:column;
}

.btn{

    width:100%;
}

}

</style>